# Application Configuration
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-production-to-a-secure-random-string

# Database
DATABASE_URL=postgresql+asyncpg://tradebot:tradebot_password@postgres:5432/tradebot

# Redis
REDIS_URL=redis://redis:6379/0

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================
# EXCHANGE API KEYS
# ============================================
# NEVER commit real API keys to version control!
# Use testnet/sandbox keys for development

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Bitget
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

# Bybit
BYBIT_API_KEY=
BYBIT_API_SECRET=

# OKX
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# KuCoin
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=

# Coinbase
COINBASE_API_KEY=
COINBASE_API_SECRET=

# ============================================
# NEWS & SENTIMENT API KEYS
# ============================================

# CoinGecko (optional - free tier available)
COINGECKO_API_KEY=

# CoinMarketCap (optional - free tier available)
COINMARKETCAP_API_KEY=

# CryptoPanic (optional - free tier available)
CRYPTOPANIC_API_KEY=

# Twitter/X (optional - requires approval)
TWITTER_BEARER_TOKEN=

# Reddit (optional - free tier available)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ============================================
# TRADINGVIEW WEBHOOK
# ============================================
TRADINGVIEW_WEBHOOK_SECRET=change-me-to-secure-webhook-secret

# ============================================
# MONITORING & ALERTS
# ============================================

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord alerts (optional)
DISCORD_WEBHOOK_URL=

# Email (SMTP) alerts (optional)
EMAIL_ALERTS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# STARTTLS on port 587; set SMTP_USE_TLS=false and SMTP_PORT=465 for SSL
SMTP_USE_TLS=true

# Prometheus metrics
PROMETHEUS_ENABLED=true

# Advanced logging
LOG_LEVEL=INFO
LOG_JSON=false
LOG_FILE_PATH=logs/tradebot.log
LOG_ROTATION=10 MB
LOG_RETENTION=14 days

# Global alerting switch and minimum severity: DEBUG, INFO, WARNING, ERROR, CRITICAL
ALERTS_ENABLED=true
ALERTS_MIN_LEVEL=WARNING

# ============================================
# TRADING CONFIGURATION
# ============================================

# SAFETY: Auto-trading disabled by default
ENABLE_AUTO_TRADING=false

# Risk Management
MAX_POSITION_SIZE_USD=1000.0
MAX_RISK_PER_TRADE_PERCENT=2.0
MAX_TOTAL_EXPOSURE_USD=10000.0

# ============================================
# PLUGIN: MT5 Trading
# ============================================
MT5_API_URL=http://localhost:8090
MT5_POLL_INTERVAL=30
MT5_MAX_ACCOUNTS=10
MT5_ENABLE_AGGREGATION=true
MT5_ENABLE_COPY_SIM=true
MT5_ENABLE_TRADE_REPLAY=true

# ============================================
# PLUGIN: AI Market Analyst
# ============================================
# Uses OPENAI_API_KEY from above
AI_ANALYST_MODEL=fable-5-high
AI_ANALYST_REASONING=medium
AI_ANALYST_MAX_TOKENS=4096
AI_ANALYST_MAX_DAILY=50
AI_ANALYST_MIN_SL_PCT=0.3
AI_ANALYST_MAX_LOT=1.0
AI_ANALYST_MIN_LOT=0.01
AI_ANALYST_MAX_RISK_PCT=2.0
AI_ANALYST_RPM=20
AI_ANALYST_PROVIDERS_FILE=plugins/AiMarketAnalyst/backend/providers.json
AI_ANALYST_PROVIDERS_JSON=
AI_ANALYST_ROUTING_STRATEGY=round_robin
AI_ANALYST_ROUTING_FALLBACK=true
AI_ANALYST_PROVIDER_TIMEOUT_S=30
AI_ANALYST_PROVIDER_MAX_RETRIES=0
AI_ANALYST_REDIS_URL=
# Optional FreeLLMAPI local override. Use 3002 to avoid the Tradebot frontend on 3001.
AI_ANALYST_FREELLMAPI_BASE_URL=http://localhost:3002/v1
AI_ANALYST_FREELLMAPI_DEFAULT_MODEL=auto

# ============================================
# PLUGIN: Obsidian Knowledge
# ============================================
# start.py automatically adds these to your .env on first run.
# After enabling the Local REST API plugin in Obsidian, copy its API token and
# paste it below.
OBSIDIAN_VAULT_PATH=~/Sites/tradebot/obsidian-vault
OBSIDIAN_REST_URL=https://localhost:27124
OBSIDIAN_REST_TOKEN=                   # <-- paste token from Obsidian Local REST API plugin
OBSIDIAN_AUTO_SYNC_MINUTES=15
OBSIDIAN_EXPORT_DECISIONS=true
OBSIDIAN_EXPORT_SIGNALS=true
OBSIDIAN_EXPORT_COMMUNITIES=true
OBSIDIAN_INJECT_CONTEXT=false          # set true to enrich agent prompts with vault notes

# ============================================
# PLUGIN: WhatsApp Signal & News (OpenWA)
# ============================================
# start.py automatically adds these to your .env on first run.
# WHATSAPP_OPENWA_API_KEY and WHATSAPP_WEBHOOK_SECRET are AUTO-GENERATED
# with secure random values on first run — no manual setup needed!
# 
# 1. Start OpenWA Gateway: docker-compose --profile whatsapp up -d
# 2. Open dashboard at http://localhost:2886
# 3. Create session, scan QR with WhatsApp
# 4. The API key and webhook secret are already in your .env!
WHATSAPP_OPENWA_BASE_URL=http://localhost:2785
WHATSAPP_OPENWA_API_KEY=               # <-- AUTO-GENERATED on first run (secure random)
WHATSAPP_DEFAULT_SESSION_NAME=tradebot_whatsapp
WHATSAPP_WEBHOOK_SECRET=               # <-- AUTO-GENERATED on first run (secure random)
WHATSAPP_POLL_INTERVAL_SECONDS=300

# Sniper auto-trade defaults (can be overridden per-channel in UI)
WHATSAPP_SNIPER_ENABLED_DEFAULT=false
WHATSAPP_SNIPER_MODE_DEFAULT=sandbox
WHATSAPP_SNIPER_POSITION_SIZE_USDT_DEFAULT=100
WHATSAPP_SNIPER_MAX_POSITIONS_DEFAULT=5
WHATSAPP_SNIPER_MIN_CONFIDENCE_DEFAULT=0.65
WHATSAPP_SNIPER_MIN_RISK_REWARD_DEFAULT=1.5

# ============================================
# HEADROOM PROXY (Self-hosted token compression)
# ============================================
# Self-hosted proxy that compresses LLM requests using headroom-ai
# Eliminates Cloudflare Workers rate limits (1000 req/min)
# 
# Enable with: docker-compose up -d headroom-proxy
# 
HEADROOM_PROXY_URL=http://localhost:8787
HEADROOM_OPENAI_API_KEY=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               # Uses OPENAI_API_KEY if not set
HEADROOM_OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
HEADROOM_HOST=0.0.0.0
HEADROOM_PORT=8787
HEADROOM_LOG_LEVEL=INFO
HEADROOM_MAX_CONCURRENT_REQUESTS=100
HEADROOM_REQUEST_TIMEOUT=60.0
