# TradingAgents sidecar — multi-agent LLM trading framework.
#
# Runs the upstream framework (PyPI release) behind a tiny FastAPI wrapper so
# the main backend never loads its heavy dependency stack in-process.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl build-essential \
    && rm -rf /var/lib/apt/lists/*

# Framework + the wrapper's own light deps, in one layer.
RUN pip install --no-cache-dir \
    "tradingagents==0.7.0" \
    fastapi \
    "uvicorn[standard]" \
    sse-starlette \
    loguru \
    python-dotenv \
    httpx

# The service package lives in the backend tree; only it is copied in.
COPY tradingagents_service/ ./tradingagents_service/

ENV TRADINGAGENTS_SERVICE_HOST=0.0.0.0 \
    TRADINGAGENTS_SERVICE_PORT=8010 \
    TRADINGAGENTS_RESULTS_DIR=/data/results

RUN mkdir -p /data/results && chown -R 1000:1000 /app /data
USER 1000

EXPOSE 8010
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s \
    CMD curl -f http://localhost:8010/health || exit 1

CMD ["python", "-m", "tradingagents_service.main"]
